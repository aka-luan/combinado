# Copy this file's variables into .env.development / .env.production as needed.
# Only NEXT_PUBLIC_ variables are readable by the client — never place a secret here.
NEXT_PUBLIC_APP_ENV=development

# Public Supabase project credentials (URL + anon key only — see PRD §15).
# Until the project is provisioned, leave these unset: the app then shows a
# clear "not configured" state instead of a broken login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VAPID *public* key only (browser PushManager.subscribe). Generate with
# `node scripts/generate-vapid-keys.mjs`. Private key / VAPID_KEYS stay in
# Supabase Edge Function secrets — see docs/runbook-push.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
